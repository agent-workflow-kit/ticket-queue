{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ticket-queue/cli/prune.json",
  "title": "prune --json",
  "description": "Counts of what was (or with --dry-run would be) removed.",
  "type": "object",
  "properties": {
    "dry_run": {
      "type": "boolean"
    },
    "removed": {
      "type": "object",
      "properties": {
        "tickets": {
          "type": "integer",
          "minimum": 0
        },
        "member_rows": {
          "type": "integer",
          "minimum": 0
        },
        "rerank_results": {
          "type": "integer",
          "minimum": 0
        },
        "events": {
          "type": "integer",
          "minimum": 0
        },
        "events_expired": {
          "type": "integer",
          "minimum": 0
        },
        "claims_lapsed": {
          "type": "integer",
          "minimum": 0
        },
        "claims_released": {
          "type": "integer",
          "minimum": 0
        },
        "tmp_dirs": {
          "type": "integer",
          "minimum": 0
        },
        "sessions": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "tickets",
        "member_rows",
        "rerank_results",
        "events",
        "events_expired",
        "claims_lapsed",
        "claims_released",
        "tmp_dirs",
        "sessions"
      ]
    },
    "warnings": {
      "$ref": "../defs.json#/$defs/warnings"
    }
  },
  "additionalProperties": false,
  "required": [
    "dry_run",
    "removed",
    "warnings"
  ]
}
