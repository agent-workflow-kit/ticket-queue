{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ticket-queue/cli/unskip.json",
  "title": "unskip --json",
  "description": "Idempotent: unchanged true when no skip was active. site is null only when unchanged is true and no store holds a skip for the key.",
  "type": "object",
  "properties": {
    "key": {
      "$ref": "../defs.json#/$defs/key"
    },
    "site": {
      "oneOf": [
        {
          "$ref": "../defs.json#/$defs/site_name"
        },
        {
          "type": "null"
        }
      ]
    },
    "requested_keys": {
      "$ref": "../defs.json#/$defs/requested_keys"
    },
    "ended": {
      "oneOf": [
        {
          "$ref": "../defs.json#/$defs/skip"
        },
        {
          "type": "null"
        }
      ]
    },
    "unchanged": {
      "type": "boolean"
    },
    "warnings": {
      "$ref": "../defs.json#/$defs/warnings"
    },
    "dry_run": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "required": [
    "key",
    "site",
    "requested_keys",
    "ended",
    "unchanged",
    "warnings",
    "dry_run"
  ],
  "if": {
    "properties": {
      "unchanged": {
        "const": false
      }
    },
    "required": [
      "unchanged"
    ]
  },
  "then": {
    "properties": {
      "site": {
        "$ref": "../defs.json#/$defs/site_name"
      }
    }
  }
}
