{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ticket-queue/cli/pin.json",
  "title": "pin --json",
  "description": "pins is the pin list after the change, in order.",
  "type": "object",
  "properties": {
    "key": {
      "$ref": "../defs.json#/$defs/key"
    },
    "site": {
      "$ref": "../defs.json#/$defs/site_name"
    },
    "requested_keys": {
      "$ref": "../defs.json#/$defs/requested_keys"
    },
    "pin": {
      "oneOf": [
        {
          "$ref": "../defs.json#/$defs/pin"
        },
        {
          "type": "null"
        }
      ]
    },
    "unchanged": {
      "type": "boolean"
    },
    "pins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "$ref": "../defs.json#/$defs/key"
          },
          "site": {
            "$ref": "../defs.json#/$defs/site_name"
          },
          "pin_position": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "key",
          "site",
          "pin_position"
        ]
      }
    },
    "warnings": {
      "$ref": "../defs.json#/$defs/warnings"
    },
    "dry_run": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "required": [
    "key",
    "site",
    "requested_keys",
    "pin",
    "unchanged",
    "pins",
    "warnings",
    "dry_run"
  ]
}
