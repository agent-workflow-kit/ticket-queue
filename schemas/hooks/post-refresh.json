{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ticket-queue/hooks/post-refresh.json",
  "title": "post-refresh hook payload (stdin)",
  "description": "After a refresh in which a board's status or error code changed (recovery included) or a claimed ticket's state changed (either direction), and at most once per hooks.refresh_repeat while a board stays failed. object_id is the board name (or the first board that changed). Delivered at least once through the outbox; deduplicate on event_id; delivery order is not guaranteed, order by seq. Consumers tolerate unknown keys. No ticket text and no repo.",
  "type": "object",
  "properties": {
    "tool": {
      "const": "ticket-queue"
    },
    "hook": {
      "const": "post-refresh"
    },
    "event_id": {
      "$ref": "../defs.json#/$defs/event_id"
    },
    "event_ts": {
      "$ref": "../defs.json#/$defs/ts"
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic per store; consumers order by seq."
    },
    "object_type": {
      "const": "board"
    },
    "object_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "description": "<site>:<KEY> for a ticket, the board name for a board."
    },
    "board": {
      "oneOf": [
        {
          "$ref": "../defs.json#/$defs/board_name"
        },
        {
          "type": "null"
        }
      ]
    },
    "key": {
      "oneOf": [
        {
          "$ref": "../defs.json#/$defs/key"
        },
        {
          "type": "null"
        }
      ]
    },
    "site": {
      "oneOf": [
        {
          "$ref": "../defs.json#/$defs/site_name"
        },
        {
          "type": "null"
        }
      ]
    },
    "holder": {
      "oneOf": [
        {
          "$ref": "../defs.json#/$defs/holder"
        },
        {
          "type": "null"
        }
      ]
    },
    "labels": {
      "$ref": "../defs.json#/$defs/claim_labels"
    },
    "requested_keys": {
      "$ref": "../defs.json#/$defs/requested_keys"
    },
    "boards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "board": {
            "$ref": "../defs.json#/$defs/board_name"
          },
          "status": {
            "$ref": "../defs.json#/$defs/board_status"
          },
          "previous_status": {
            "oneOf": [
              {
                "$ref": "../defs.json#/$defs/board_status"
              },
              {
                "type": "null"
              }
            ]
          },
          "error_code": {
            "oneOf": [
              {
                "$ref": "../defs.json#/$defs/error_code"
              },
              {
                "type": "null"
              }
            ]
          },
          "lower_code": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ]
          },
          "retry_after": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "board",
          "status",
          "previous_status",
          "error_code",
          "lower_code",
          "retry_after"
        ]
      }
    },
    "changed_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "$ref": "../defs.json#/$defs/key"
          },
          "site": {
            "$ref": "../defs.json#/$defs/site_name"
          },
          "holder": {
            "oneOf": [
              {
                "$ref": "../defs.json#/$defs/holder"
              },
              {
                "type": "null"
              }
            ]
          },
          "labels": {
            "$ref": "../defs.json#/$defs/claim_labels"
          },
          "requested_keys": {
            "$ref": "../defs.json#/$defs/requested_keys"
          },
          "ticket_state": {
            "$ref": "../defs.json#/$defs/claim_state"
          },
          "previous_state": {
            "$ref": "../defs.json#/$defs/claim_state"
          }
        },
        "additionalProperties": false,
        "required": [
          "key",
          "site",
          "holder",
          "labels",
          "requested_keys",
          "ticket_state",
          "previous_state"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "tool",
    "hook",
    "event_id",
    "event_ts",
    "seq",
    "object_type",
    "object_id",
    "board",
    "key",
    "site",
    "holder",
    "labels",
    "requested_keys",
    "boards",
    "changed_claims"
  ]
}
