{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ticket-queue/hooks/post-claim.json",
  "title": "post-claim hook payload (stdin)",
  "description": "After a claim is written (claim, next --claim). object_id is the ticket key. Delivered at least once through the outbox; deduplicate on event_id. No ticket text and no repo.",
  "type": "object",
  "properties": {
    "tool": {
      "const": "ticket-queue"
    },
    "hook": {
      "const": "post-claim"
    },
    "event_id": {
      "$ref": "../defs.json#/$defs/event_id"
    },
    "object_type": {
      "const": "ticket"
    },
    "object_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "board": {
      "oneOf": [
        {
          "$ref": "../defs.json#/$defs/board_name"
        },
        {
          "type": "null"
        }
      ]
    },
    "key": {
      "oneOf": [
        {
          "$ref": "../defs.json#/$defs/key"
        },
        {
          "type": "null"
        }
      ]
    },
    "site": {
      "oneOf": [
        {
          "$ref": "../defs.json#/$defs/site_name"
        },
        {
          "type": "null"
        }
      ]
    },
    "holder": {
      "oneOf": [
        {
          "$ref": "../defs.json#/$defs/holder"
        },
        {
          "type": "null"
        }
      ]
    },
    "labels": {
      "$ref": "../defs.json#/$defs/claim_labels"
    },
    "counts": {
      "$ref": "../defs.json#/$defs/counts"
    },
    "renewed": {
      "type": "boolean"
    },
    "expires_at": {
      "$ref": "../defs.json#/$defs/ts"
    },
    "ttl_s": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "tool",
    "hook",
    "event_id",
    "object_type",
    "object_id",
    "board",
    "key",
    "site",
    "holder",
    "labels",
    "counts",
    "renewed",
    "expires_at",
    "ttl_s"
  ]
}
