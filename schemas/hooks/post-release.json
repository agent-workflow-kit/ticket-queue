{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ticket-queue/hooks/post-release.json",
  "title": "post-release hook payload (stdin)",
  "description": "After a claim ends by release, a lapsed TTL, prune, force or a merge of a moved key. Delivered at least once through the outbox; deduplicate on event_id; delivery order is not guaranteed, order by seq. Consumers tolerate unknown keys. No ticket text and no repo.",
  "type": "object",
  "properties": {
    "tool": {
      "const": "ticket-queue"
    },
    "hook": {
      "const": "post-release"
    },
    "event_id": {
      "$ref": "../defs.json#/$defs/event_id"
    },
    "event_ts": {
      "$ref": "../defs.json#/$defs/ts"
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic per store; consumers order by seq."
    },
    "object_type": {
      "const": "ticket"
    },
    "object_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "description": "<site>:<KEY> for a ticket, the board name for a board."
    },
    "board": {
      "oneOf": [
        {
          "$ref": "../defs.json#/$defs/board_name"
        },
        {
          "type": "null"
        }
      ]
    },
    "key": {
      "oneOf": [
        {
          "$ref": "../defs.json#/$defs/key"
        },
        {
          "type": "null"
        }
      ]
    },
    "site": {
      "oneOf": [
        {
          "$ref": "../defs.json#/$defs/site_name"
        },
        {
          "type": "null"
        }
      ]
    },
    "holder": {
      "oneOf": [
        {
          "$ref": "../defs.json#/$defs/holder"
        },
        {
          "type": "null"
        }
      ]
    },
    "labels": {
      "$ref": "../defs.json#/$defs/claim_labels"
    },
    "requested_keys": {
      "$ref": "../defs.json#/$defs/requested_keys"
    },
    "failed": {
      "type": "boolean"
    },
    "reason": {
      "$ref": "../defs.json#/$defs/release_reason"
    },
    "forced": {
      "type": "boolean"
    },
    "actor": {
      "$ref": "../defs.json#/$defs/actor"
    },
    "claimed_at": {
      "$ref": "../defs.json#/$defs/ts"
    },
    "consecutive_failures": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "tool",
    "hook",
    "event_id",
    "event_ts",
    "seq",
    "object_type",
    "object_id",
    "board",
    "key",
    "site",
    "holder",
    "labels",
    "requested_keys",
    "failed",
    "reason",
    "forced",
    "actor",
    "claimed_at",
    "consecutive_failures"
  ]
}
