{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ticket-queue/audit",
  "title": "ticket-queue audit.jsonl record",
  "description": "Empty contract. ticket-queue takes no external action, so no audit.jsonl record is written in 0.x; this file exists only for tools that read every tool's audit schema. The shape is the scaffold's.",
  "type": "object",
  "properties": {
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "string"
    },
    "decision_id": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "target": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "inputs": {
      "type": "object"
    },
    "result": {}
  },
  "required": [
    "ts",
    "actor",
    "target",
    "action",
    "result"
  ],
  "additionalProperties": true
}
