{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ticket-queue/defs.json",
  "title": "ticket-queue shared definitions",
  "description": "Not an output on its own. Shared definitions referenced by the CLI, hook, log and re-rank schemas. config.json embeds its own copies.",
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*-[0-9]+$",
      "maxLength": 64,
      "description": "Ticket key, printed upper-case."
    },
    "project_key": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "maxLength": 64
    },
    "site_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "board_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "holder": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:/#@+=,-]{1,256}$",
      "description": "Opaque claim holder: 1 to 256 characters of the label-value set."
    },
    "key_input": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*-[0-9]+$",
      "maxLength": 64,
      "description": "A ticket key as typed in config: any letter case, stored upper-case."
    },
    "requested_keys": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/key"
      },
      "uniqueItems": true,
      "maxItems": 16,
      "description": "Aliases: keys a ticket was requested or made under before it moved."
    },
    "cron_interval": {
      "enum": [
        "1m",
        "2m",
        "3m",
        "4m",
        "5m",
        "6m",
        "10m",
        "12m",
        "15m",
        "20m",
        "30m",
        "1h",
        "2h",
        "3h",
        "4h",
        "6h",
        "8h",
        "12h",
        "24h"
      ]
    },
    "label_key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
    },
    "claim_label": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}=[A-Za-z0-9._:/#@+=,-]{0,256}$",
      "description": "A claim label as key=value (split at the first =). Labels are a multiset."
    },
    "claim_labels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim_label"
      },
      "maxItems": 64
    },
    "ts": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "UTC ISO 8601 with Z, to the second."
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "duration": {
      "type": "string",
      "pattern": "^[0-9]{1,6}(ms|s|m|h|d|w)$"
    },
    "actor": {
      "type": "string",
      "pattern": "^(?:human|auto):[A-Za-z0-9._@-]{1,64}$"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:@/-]{1,128}$"
    },
    "decision_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision_id"
      },
      "maxItems": 16
    },
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{8,64}$",
      "description": "Outbox event id; a receiver deduplicates on it."
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status_category": {
      "enum": [
        "new",
        "indeterminate",
        "done"
      ]
    },
    "sprint_state": {
      "enum": [
        "future",
        "active",
        "closed"
      ]
    },
    "incomplete": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.]{0,63}$"
      },
      "description": "Parts ticketctl reported as cut off or unavailable (ticketctl's incomplete)."
    },
    "status": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "category": {
          "$ref": "#/$defs/status_category"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "category"
      ]
    },
    "account": {
      "type": "object",
      "properties": {
        "account_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9:_.-]{1,128}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "display_name": {
          "type": "string",
          "maxLength": 256,
          "x-untrusted": true
        }
      },
      "additionalProperties": false,
      "required": [
        "account_id",
        "display_name"
      ]
    },
    "sprint_ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string",
          "maxLength": 256,
          "x-untrusted": true
        },
        "state": {
          "$ref": "#/$defs/sprint_state"
        },
        "start": {
          "oneOf": [
            {
              "$ref": "#/$defs/ts"
            },
            {
              "type": "null"
            }
          ]
        },
        "end": {
          "oneOf": [
            {
              "$ref": "#/$defs/ts"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "state",
        "start",
        "end"
      ]
    },
    "parent": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "type": {
          "type": "string",
          "maxLength": 256
        },
        "title": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 4096,
              "x-untrusted": true
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "key",
        "type",
        "title"
      ]
    },
    "blocked": {
      "type": "object",
      "properties": {
        "value": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "by": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/key"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "required": [
        "value",
        "by"
      ]
    },
    "rule": {
      "enum": [
        "done",
        "gone",
        "hidden",
        "claimed",
        "skipped",
        "status",
        "pointed",
        "sprint",
        "unblocked",
        "assignee",
        "parent"
      ]
    },
    "verdict": {
      "type": "object",
      "properties": {
        "result": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "reason": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "overridden_by_pin": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "result",
        "reason",
        "overridden_by_pin"
      ]
    },
    "verdicts": {
      "type": "object",
      "properties": {
        "done": {
          "$ref": "#/$defs/verdict"
        },
        "gone": {
          "$ref": "#/$defs/verdict"
        },
        "hidden": {
          "$ref": "#/$defs/verdict"
        },
        "claimed": {
          "$ref": "#/$defs/verdict"
        },
        "skipped": {
          "$ref": "#/$defs/verdict"
        },
        "status": {
          "$ref": "#/$defs/verdict"
        },
        "pointed": {
          "$ref": "#/$defs/verdict"
        },
        "sprint": {
          "$ref": "#/$defs/verdict"
        },
        "unblocked": {
          "$ref": "#/$defs/verdict"
        },
        "assignee": {
          "$ref": "#/$defs/verdict"
        },
        "parent": {
          "$ref": "#/$defs/verdict"
        }
      },
      "additionalProperties": false,
      "required": [
        "done",
        "gone",
        "hidden",
        "claimed",
        "skipped",
        "status",
        "pointed",
        "sprint",
        "unblocked",
        "assignee",
        "parent"
      ],
      "description": "One verdict per eligibility rule; a rule that is unknown excludes the ticket as fail does."
    },
    "error_code": {
      "enum": [
        "internal",
        "invalid_argument",
        "not_found",
        "partial_results",
        "lower_failed",
        "rerank_failed",
        "unavailable",
        "tui_missing",
        "tool_missing",
        "tool_too_old",
        "schema_newer",
        "not_implemented",
        "refused",
        "ambiguous_key"
      ],
      "description": "A closed class per exit code: 1 internal; 2 invalid_argument; 10 not_found; 12 partial_results, lower_failed, rerank_failed, unavailable, tui_missing, tool_missing, tool_too_old, schema_newer, not_implemented; 20 refused; 21 ambiguous_key."
    },
    "error_reason": {
      "enum": [
        "bad_query",
        "unknown_field",
        "order_by_not_allowed",
        "invalid_config",
        "site_required",
        "claim_required",
        "human_only",
        "too_expensive",
        "invalid_interval",
        "contended",
        "output_too_large",
        "claimed",
        "done",
        "gone",
        "skipped",
        "hidden",
        "holder_mismatch",
        "not_held",
        "rerank_disabled"
      ],
      "description": "Exit 2: bad_query, unknown_field, order_by_not_allowed, invalid_config, site_required, claim_required, human_only, too_expensive, invalid_interval. Exit 12: contended, output_too_large. Exit 20: claimed, done, gone, skipped, hidden, holder_mismatch, not_held, rerank_disabled."
    },
    "lower_error": {
      "type": "object",
      "properties": {
        "tool": {
          "enum": [
            "ticketctl",
            "claude-session"
          ]
        },
        "exit": {
          "type": "integer",
          "minimum": 0
        },
        "code": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "tool",
        "exit",
        "code",
        "reason"
      ],
      "description": "Copied from the lower tool: its exit code, error code and reason."
    },
    "error_body": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/error_code"
        },
        "message": {
          "type": "string",
          "maxLength": 4096,
          "x-untrusted": true
        },
        "reason": {
          "oneOf": [
            {
              "$ref": "#/$defs/error_reason"
            },
            {
              "type": "null"
            }
          ]
        },
        "details": {
          "type": "object",
          "description": "Open object. Known keys: candidates (ambiguous_key), boards (partial_results; also not_found of show and why), results (rerank_failed), errors, lower_error, position (bad_query), key, board, holder."
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "reason"
      ]
    },
    "warning_code": {
      "enum": [
        "soft_rule_overridden",
        "reassigned",
        "estimate_ambiguous",
        "departures_unchecked",
        "sandbox_inactive",
        "refresh_partial",
        "scan_limit_reached",
        "me_unknown",
        "pinned_blocked",
        "ticket_done",
        "ticket_skipped",
        "weights_differ",
        "pass_env_overlap",
        "browse_query_invalid"
      ]
    },
    "warning": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/warning_code"
        },
        "message": {
          "type": "string",
          "maxLength": 1024,
          "x-untrusted": true
        },
        "rule": {
          "$ref": "#/$defs/rule"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "board": {
          "$ref": "#/$defs/board_name"
        }
      },
      "additionalProperties": false,
      "required": [
        "code"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    },
    "claim": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "site": {
          "$ref": "#/$defs/site_name"
        },
        "requested_keys": {
          "$ref": "#/$defs/requested_keys"
        },
        "board": {
          "oneOf": [
            {
              "$ref": "#/$defs/board_name"
            },
            {
              "type": "null"
            }
          ]
        },
        "holder": {
          "oneOf": [
            {
              "$ref": "#/$defs/holder"
            },
            {
              "type": "null"
            }
          ]
        },
        "labels": {
          "$ref": "#/$defs/claim_labels"
        },
        "claimed_at": {
          "$ref": "#/$defs/ts"
        },
        "renewed_at": {
          "$ref": "#/$defs/ts"
        },
        "expires_at": {
          "$ref": "#/$defs/ts"
        },
        "ttl_s": {
          "type": "integer",
          "minimum": 1
        },
        "consecutive_failures": {
          "type": "integer",
          "minimum": 0
        },
        "ticket_state": {
          "$ref": "#/$defs/claim_state"
        },
        "expires_in_s": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "key",
        "site",
        "board",
        "holder",
        "labels",
        "claimed_at",
        "renewed_at",
        "expires_at",
        "ttl_s",
        "consecutive_failures"
      ],
      "description": "board is the ticket's current owner, computed when read (null for a ticket in no pool)."
    },
    "claim_state": {
      "enum": [
        "ok",
        "done",
        "gone",
        "reassigned",
        "moved"
      ]
    },
    "pin": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "site": {
          "$ref": "#/$defs/site_name"
        },
        "requested_keys": {
          "$ref": "#/$defs/requested_keys"
        },
        "pin_position": {
          "type": "integer",
          "minimum": 1
        },
        "expires_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/ts"
            },
            {
              "type": "null"
            }
          ]
        },
        "blocked": {
          "type": "boolean"
        },
        "created_at": {
          "$ref": "#/$defs/ts"
        },
        "blocked_reason": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "key",
        "site",
        "pin_position",
        "expires_at",
        "blocked"
      ]
    },
    "skip": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "site": {
          "$ref": "#/$defs/site_name"
        },
        "requested_keys": {
          "$ref": "#/$defs/requested_keys"
        },
        "source": {
          "enum": [
            "human",
            "auto"
          ]
        },
        "until": {
          "oneOf": [
            {
              "$ref": "#/$defs/ts"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "$ref": "#/$defs/ts"
        },
        "reason": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 4096,
              "x-untrusted": true
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "key",
        "site",
        "source",
        "until",
        "reason"
      ]
    },
    "rerank_ref": {
      "type": "object",
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "position": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "excluded": {
          "type": "boolean"
        },
        "reason": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 200,
              "x-untrusted": true
            },
            {
              "type": "null"
            }
          ]
        },
        "age_s": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "applied",
        "position",
        "excluded",
        "reason",
        "age_s"
      ]
    },
    "board_status": {
      "enum": [
        "ok",
        "refresh_failed",
        "truncated",
        "disabled"
      ]
    },
    "board_state": {
      "type": "object",
      "properties": {
        "board": {
          "$ref": "#/$defs/board_name"
        },
        "site": {
          "oneOf": [
            {
              "$ref": "#/$defs/site_name"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/board_status"
        },
        "already_running": {
          "type": "boolean"
        },
        "refreshed_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/ts"
            },
            {
              "type": "null"
            }
          ]
        },
        "stale": {
          "type": "boolean"
        },
        "last_full_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/ts"
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "enum": [
            "full",
            "incremental"
          ]
        },
        "fetch": {
          "enum": [
            "complete",
            "truncated",
            "failed"
          ]
        },
        "pages": {
          "type": "integer",
          "minimum": 0
        },
        "counts": {
          "type": "object",
          "properties": {
            "fetched": {
              "type": "integer",
              "minimum": 0
            },
            "upserted": {
              "type": "integer",
              "minimum": 0
            },
            "members_removed": {
              "type": "integer",
              "minimum": 0
            },
            "departures_checked": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "fetched",
            "upserted",
            "members_removed",
            "departures_checked"
          ]
        },
        "departures_unchecked": {
          "type": "boolean"
        },
        "pool": {
          "type": "integer",
          "minimum": 0
        },
        "eligible": {
          "type": "integer",
          "minimum": 0
        },
        "claimed": {
          "type": "integer",
          "minimum": 0
        },
        "pinned": {
          "type": "integer",
          "minimum": 0
        },
        "pinned_blocked": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "type": "object",
          "description": "The board's configured source, as in config."
        },
        "error": {
          "$ref": "#/$defs/error_body"
        },
        "retry_after": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "lower_error": {
          "$ref": "#/$defs/lower_error"
        },
        "warnings": {
          "$ref": "#/$defs/warnings"
        },
        "rerank": {
          "enum": [
            "off",
            "ok",
            "failed",
            "expired",
            "none"
          ]
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "board",
        "status"
      ],
      "description": "status disabled means a configuration error or enabled: false; rerank_disabled is never a board status."
    },
    "ticket_base": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "site": {
          "$ref": "#/$defs/site_name"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "title": {
          "type": "string",
          "maxLength": 4096,
          "x-untrusted": true
        },
        "description": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 8192,
              "x-untrusted": true
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 256
            },
            "subtask": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "name",
            "subtask"
          ]
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "assignee": {
          "oneOf": [
            {
              "$ref": "#/$defs/account"
            },
            {
              "type": "null"
            }
          ]
        },
        "reporter": {
          "oneOf": [
            {
